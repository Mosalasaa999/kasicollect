<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0F172A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KasiCollect Edge"
        android:textColor="#38BDF8"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alex Ward 108 • Corridor 8th-12th"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <!-- Scale Readout Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="20dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLUETOOTH SCALE (WH-A08)"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvWeightDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00 kg"
            android:textColor="#4ADE80"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Scale Standby / Disconnected"
            android:textColor="#F59E0B"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSimulateWeigh"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Simulate Verified PET Scale Reading (4.25kg)"
        android:backgroundTint="#2563EB"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnTriggerSync"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Sync Offline Ledger to Cloud"
        android:backgroundTint="#059669"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvLedgerCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Local Encrypted Queue: 0 pending collections"
        android:textColor="#CBD5E1"
        android:textSize="14sp" />
</LinearLayout>
